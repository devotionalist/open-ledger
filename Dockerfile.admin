# Multi-stage: compile openledger-admin on Linux (oxia-client/compio),
# then ship a slim runtime image.
#
#   docker build -f Dockerfile.admin -t openledger-admin:local .
FROM rust:1.99-bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY proto ./proto
RUN cargo build --release -p openledger-admin

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/openledger-admin /usr/local/bin/openledger-admin
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/openledger-admin"]
